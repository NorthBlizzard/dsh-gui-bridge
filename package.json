{
  "name": "dsh-gui-bridge",
  "version": "1.0.0",
  "description": "Agent tools that drive DeepSeek Harness GUI operations: sessions, workspaces, permission mode, settings, and the plugin market.",
  "type": "module",
  "license": "MIT",
  "author": "NorthBlizzard",
  "homepage": "https://github.com/NorthBlizzard/dsh-gui-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NorthBlizzard/dsh-gui-bridge.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "gui",
    "automation",
    "tools"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "market"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
